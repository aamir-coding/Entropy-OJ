{
  "name": "@entropy-oj/worker",
  "version": "1.0.0",
  "description": "Dockerized Sandboxed Evaluation Worker for Entropy",
  "main": "dist/worker.js",
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "node dist/worker.js",
    "dev": "tsx watch src/worker.ts",
    "build:image": "docker build -t entropy-runner:latest -t oj-runner:latest -f docker/Dockerfile.runner docker",
    "image:prune": "docker image prune -f",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@entropy-oj/shared": "*",
    "bullmq": "^5.41.6",
    "dotenv": "^16.4.7",
    "ioredis": "^5.5.0",
    "mongoose": "^8.10.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}

# Execution environment: development, production, test
NODE_ENV=development

# MongoDB connection URI (replica set recommended in production for transactions)
MONGO_URI=mongodb://localhost:27017/anti_oj

# Redis configuration for BullMQ job queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Docker Sandbox runner image tag
RUNNER_IMAGE=oj-runner:latest

# Worker concurrency (recommended: match available CPU cores on worker host, e.g. 2-8)
WORKER_CONCURRENCY=2

# Docker container wall-clock hard timeout in seconds
DOCKER_TIMEOUT_SEC=15

# HTTP health probe port for container orchestrators (Kubernetes liveness/readiness)
WORKER_HEALTH_PORT=5001


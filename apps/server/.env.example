PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/entropy_oj
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_KEY_MINIMUM_32_BYTES
JWT_EXPIRES_DAYS=7
CLIENT_URL=http://localhost:5173

# =================================================================
# AI Features Configuration ($0 Inference Budget / 100% Free Tiers)
# =================================================================

# Feature Flags (set to "false" to independently disable any feature)
FEATURE_AI_HINTS=true
FEATURE_AI_REVIEW=true
FEATURE_AI_CLASSIFY=true

# 1. Groq (Feature 1: Real-time Socratic Debug Copilot - Primary Provider)
# Get a free key at: https://console.groq.com (No credit card required)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_RPM_LIMIT=30

# 2. Google Gemini Flash (Feature 2: Problem-Setting Co-Pilot - Admin Only)
# Get a free key at: https://aistudio.google.com (No credit card required)
# Note: Google's free tier terms allow prompt data to be used for model improvement.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM_LIMIT=10
GEMINI_RPD_LIMIT=1500

# 3. OpenRouter (Feature 5: Post-AC Approach Classifier & Feature 1 Fallback)
# Get a free key at: https://openrouter.ai (No credit card required)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/free,meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-r1:free,qwen/qwen-2.5-coder-32b-instruct:free
OPENROUTER_RPM_LIMIT=20
OPENROUTER_RPD_LIMIT=50

# Per-User Hint Quotas (Independent of provider limits)
AI_HINT_USER_DAILY_LIMIT=20
AI_HINT_USER_HOURLY_LIMIT=5


# Admin Seeder Password (REQUIRED if running seed in production; defaults to admin123456 in development)
ADMIN_SEED_PASSWORD=
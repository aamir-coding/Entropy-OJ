# ============================================================
#  Entropy Online Judge — Oracle Cloud VM Environment Variables
#  Used by: docker-compose.prod.yml
#
#  Copy this file to .env on the Oracle VM:
#    cp .env.oracle-vm.example .env
#    nano .env
# ============================================================

# MongoDB Atlas connection string (same as Render server)
# Get from: MongoDB Atlas → Connect → Drivers → Node.js
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/entropy_oj?retryWrites=true&w=majority

# Redis password (must match the REDIS_PASSWORD on the Render server)
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=

# Worker concurrency (recommended: match OCPU count, e.g., 2 for 2 OCPU)
WORKER_CONCURRENCY=2

# Docker sandbox timeout in seconds
DOCKER_TIMEOUT_SEC=15
